# LLM 网关（OpenAI 兼容）。任意一家都行：DeepSeek / 通义 / 硅基流动 / OpenAI。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL_PLANNER=deepseek-flash
LLM_MODEL_FAST=deepseek-flash
# 多模态（素材诊断）：DeepSeek 用 deepseek-flash；换别家填对应 VLM 名
LLM_MODEL_VISION=deepseek-flash
# auto: 有 key 调真模型，无 key 自动走规则版；real: 强制真调用；mock: 强制规则版
LLM_MODE=auto
# off: 调用时关掉「思考链」（deepseek-flash 关掉后规划从 8.7s 降到 0.9s）；
# on: 不干预，让模型自己决定；换到不认 thinking 参数的网关时设 on
LLM_THINKING=off
# 单次调用超时（毫秒）与重试次数：端到端预算 8s，别给太长
LLM_TIMEOUT_MS=12000
LLM_RETRIES=1
# 反方审查默认只用规则版（约 0.6s）；设 true 时再让模型挑一遍毛病（+2s 左右）
CRITIC_LLM=false
# 报告改写预算闸：工具跑完已耗时超过它，就跳过模型改写直接用模板（毫秒）
REPORT_BUDGET_MS=7000

# 素材诊断：auto=有 key 用视觉模型现算 / 无 key 回放真值；mock=永远回放；vlm=强制现算
VISION_MODE=auto
VISION_DETAIL=low
VISION_MAX_SIDE=800

# 应用
APP_ENV=dev
DB_PATH=data/store.db
LOG_LEVEL=INFO

# —— 登录鉴权 ——
# password = 需要登录（默认）；off = 关掉鉴权（仅本机调试/自动化测试用，接口会全部放行）
AUTH_MODE=password
# 首次启动时创建的店主账号 admin 的初始密码。留空则随机生成，写在 .tmp/first-run.txt 里
# 初始密码只用于第一次登录，登录后必须改密（must_change），所以留空更安全
AUTH_ADMIN_PASSWORD=
# 登录态 Cookie 有效期（小时），默认 7 天
SESSION_TTL_HOURS=168
# 走 HTTPS 时设为 true（Cookie 加 Secure）；本机 http 用 false
COOKIE_SECURE=false

# 演示基准日（首屏与默认诊断的 as_of；超出数据范围自动回落最新一天）
DEMO_AS_OF=2026-11-17

# 检索（混合召回 + 三级重排，见 spec §20）
EMBED_MODE=local
EMBED_MODEL_PATH=
EMBED_DIM=1024
RERANK_MODE=rule
RERANK_MODEL_PATH=
RERANK_TOP_N=6
RERANK_TIMEOUT_MS=3500

# —— 阶段 2：创意工单（把「素材有问题」变成「改进后的图」）——
# local     = 本地 PIL 按问题码改图（默认；不需要任何 key，离线可跑）
# dashscope = 调阿里云百炼的生图 / 改图（要下面那把 key，按张计费）
CREATIVE_PROVIDER=local
# 百炼控制台 → API-KEY 管理 → 创建；形如 sk-xxxxxxxx
# 注意：这是阿里云百炼的 key，与上面 DeepSeek 的 LLM_API_KEY 是两个厂商，不能混用
DASHSCOPE_API_KEY=
# dashscope 档用的模型：文生图（重画）与图生图（在现有主图上改）
CREATIVE_IMAGE_MODEL=wan2.2-t2i-flash
CREATIVE_EDIT_MODEL=wan2.5-i2i-preview
# 可选：把创意生成委派给外部 HTTP 服务（例如 self-host 的创意 Agent）；留空 = 本地
CREATIVE_ADAPTER=
